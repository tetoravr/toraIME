#include <winver.h>
#include "resource.h"

IDI_TORAIME ICON "../tsf/toraime.ico"
1 24 "settings_app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104b0"
    BEGIN
      VALUE "FileDescription", "toraIME Settings"
      VALUE "FileVersion", "0.1.0"
      VALUE "OriginalFilename", "toraime_settings.exe"
      VALUE "ProductName", "toraIME"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0411, 1200
  END
END
